# Bedrock Horizons

# Normalize line endings
* text=auto eol=lf

# GitHub Linguist
*.json linguist-language=JavaScript
*.jsonc linguist-language=JavaScript
*.mcpack linguist-generated=true
*.mcaddon linguist-generated=true
build/** linguist-generated=true
dist/** linguist-generated=true
release/** linguist-generated=true

# Text Files
*.json text
*.js text
*.ts text
*.md text
*.txt text
*.yml text
*.yaml text
*.mcmeta text

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.tga binary
*.dds binary
*.ico binary

# Audio
*.ogg binary
*.wav binary
*.mp3 binary

# Fonts
*.ttf binary
*.otf binary

# Minecraft Packages
*.mcpack binary
*.mcaddon binary

# Scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# Generated pack output -- produced by tools/build.py, not hand-edited.
textures/blocks/** linguist-generated=true
textures/items/** linguist-generated=true
textures/entity/** linguist-generated=true
textures/particle/** linguist-generated=true
textures/caustics/** linguist-generated=true
lighting/** linguist-generated=true
atmospherics/** linguist-generated=true
fogs/** linguist-generated=true
color_grading/** linguist-generated=true
water/** linguist-generated=true
shadows/** linguist-generated=true
local_lighting/** linguist-generated=true
pbr/** linguist-generated=true
biomes/** linguist-generated=true
subpacks/** linguist-generated=true
